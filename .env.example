# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable ("anon") key — safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret ("service_role") key — SERVER ONLY. Never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ===== App =====
# Absolute origin of the deployment. Used for metadataBase, transactional email
# links, and Supabase redirect URLs. http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Email (Mailjet) =====
MAILJET_API_KEY=xxx
MAILJET_API_SECRET=xxx
# EMAIL_FROM is the literal "From" address recipients see on every transactional
# email. It MUST be a sender you have verified in your Mailjet account
# (Account > Senders & Domains) — Mailjet rejects sends from any unverified
# address.
EMAIL_FROM=noreply@yourdomain.com
# Display name shown beside EMAIL_FROM. Optional — falls back to the Scire brand name.
EMAIL_FROM_NAME=Scire
# Set to 1 to skip real Mailjet dispatch (each send is still logged). Used by
# smokes and local development. Leave empty/unset in production.
EMAIL_DRY_RUN=
# Max manager broadcasts allowed per organization per day.
ORG_EMAIL_DAILY_CAP=10

# ===== Cron (session reminders) =====
CRON_SECRET=generate-with-openssl-rand-hex-32
